# EcoGuard Environment Configuration
# Copy this file to .env and fill in real values before running.

# Flask & API security
SECRET_KEY=replace-with-a-long-random-secret-key
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
API_TOKEN_MAX_AGE=86400
ALLOW_UNVERIFIED_DEV_SIGNUP=false
FRONTEND_ORIGIN=http://localhost:3000

# Default admin account password
ADMIN_PASSWORD=change-me-admin-password

# Database (leave unset for local SQLite, or set Neon/Postgres URL in production)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Earth Engine
GEE_PROJECT_ID=n8n-gmail-project-504217
# For cloud deployment (Render / HF Spaces), paste your GCP Service Account JSON or base64 JSON:
# GEE_SERVICE_ACCOUNT_JSON=
GEE_CACHE_TTL_SECONDS=1800
GEE_CACHE_MAX_ENTRIES=128

# DeepSeek LLM (TokenHarbor OpenAI-compatible API)
LLM_BASE_URL=https://tokenharbor.ai/v1
LLM_API_KEY=
LLM_PRIMARY_MODEL=deepseek-v4.1-flash-1017
LLM_FALLBACK_MODEL=deepseek-v4.1-flash:free
LLM_TIMEOUT_SECONDS=30

# Email (Gmail SMTP SSL) for account verification, password reset & alerts
MAIL_USERNAME=
MAIL_PASSWORD=
ALERT_EMAIL=

# Green coverage & reforestation targets
GREEN_TARGET=60
TREES_PER_HECTARE=400

# Logging
LOG_LEVEL=INFO
